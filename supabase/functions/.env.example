# Supabase Edge Functions Environment Variables Example
# Copy to supabase/functions/.env for local development

# Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# AI Models (defaults if not set)
LLM_MODEL=claude-3-5-sonnet-20241022
ASR_MODEL=whisper-1

# Supabase Credentials (auto-populated by supabase start / supabase functions serve)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Demo mode toggle (true allows instant mock responses without external API keys)
DEMO_MODE=true
