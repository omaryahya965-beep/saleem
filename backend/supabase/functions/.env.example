# Edge Function secrets. Set on the hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real .env.

# AI provider: Google Gemini only (D161). Analysis, vision and Arabic transcription all use it.
# There is no OpenAI fallback; LLM_PROVIDER / TRANSCRIPTION_PROVIDER / OPENAI_API_KEY are not read.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: LOW (default) | MEDIUM | HIGH. Thinking is billed as output tokens and drives latency.
# GEMINI_THINKING_LEVEL=LOW
# Optional: another Gemini model used only when GEMINI_MODEL answers 503 (overloaded); recorded per run.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Pricing overrides (optional)
# PRICE_GEMINI_3_8_FLASH=0.75,0.075,3.75  # paid-tier estimate: input,cached,output per 1M tokens
