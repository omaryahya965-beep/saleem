# Edge Function secrets. Set on the hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real .env.

# Required
OPENAI_API_KEY=sk-...

# Providers (only "openai" is enabled; "gemini" / "anthropic" are wired but disabled)
TRANSCRIPTION_PROVIDER=openai
# Must return segment timestamps. whisper-1 (default) gives sentence-level segments;
# gpt-4o-transcribe-diarize segments by speaker turn (too coarse for a single-speaker clip).
TRANSCRIPTION_MODEL=whisper-1
LLM_PROVIDER=openai
# Vision + reasoning with strict JSON output: gpt-6.1-sol (default, ~$0.05–0.07/clip) or gpt-6-luna (~$0.004/clip)
LLM_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=medium

# Optional
# ANALYZE_RATE_LIMIT_PER_HOUR=30
# PRICE_GPT_6_1_SOL=2,0.1,10   # override USD per 1M tokens: input,cached,output
