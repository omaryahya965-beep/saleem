# Edge Function secrets. Set on the hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real .env.

# Required for Gemini (server-side only; never use a VITE_ prefix).
GEMINI_API_KEY=your-gemini-api-key
# Working model from live verification on 2026-11-17; availability can vary by key/time.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini handles both speech and compliance analysis without an OpenAI key.
TRANSCRIPTION_PROVIDER=gemini
LLM_PROVIDER=gemini
# Optional OpenAI alternative: set either/both providers to openai and supply this key.
# OPENAI_API_KEY=your-openai-api-key
# Must return segment timestamps. whisper-1 (default) gives sentence-level segments;
# gpt-4o-transcribe-diarize segments by speaker turn (too coarse for a single-speaker clip).
TRANSCRIPTION_MODEL=whisper-1
# Vision + reasoning with strict JSON output: gpt-6.1-sol (default, ~$0.05–0.07/clip) or gpt-6-luna (~$0.004/clip)
LLM_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=medium

# Optional
# ANALYZE_RATE_LIMIT_PER_HOUR=30
# PRICE_GPT_6_1_SOL=2,0.1,10   # override USD per 1M tokens: input,cached,output
# PRICE_GEMINI_3_8_FLASH=0.75,0.075,3.75  # paid-tier estimate; override for your tier
