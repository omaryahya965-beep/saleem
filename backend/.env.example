# Backend & Frontend Shared Environment Variables
# Copy to backend/.env for local or hosted development:
#   cp backend/.env.example backend/.env

# Public Supabase credentials (VITE_* variables are loaded into the frontend bundle via envDir)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-side Supabase credentials
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional: Service Role key for administrative scripts (e.g. seed-demo-user)
# Leave commented out if managing users via the Supabase dashboard
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set to true to force offline demo fixtures; false connects to live Supabase backend
VITE_DEMO_MODE=false
