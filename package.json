{
  "name": "saleem",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "lint": "npm --workspace=frontend run lint",
    "format": "npm --workspace=frontend run format",
    "test:frontend": "npm --workspace=frontend run test",
    "test:backend": "npm --workspace=backend run test",
    "test": "npm --workspace=frontend run test && npm --workspace=backend run test",
    "verify:backend": "npm --workspace=backend run verify",
    "seed:backend": "npm --workspace=backend run seed"
  }
}
